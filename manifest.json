{
  "manifest_version": 3,
  "name": "Chrome Gesture Control",
  "version": "2.0",
  "description": "웨일 브라우저처럼 마우스 오른쪽 버튼으로 그리는 제스처로 크롬을 조작합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sessions",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gesture Control",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "gesture.js"],
      "run_at": "document_start"
    }
  ]
}
